                <zone h='77000' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98400' x='800' y='22000'>
                  <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Loans with Bonus Conditions (e.g. insurance bundles) show an average APR of 4.2%, lower than the 4.5% APR for loans without bonuses.&#10;The difference of -0.3 percentage points is statistically significant. (p = 0.02)' captured-sheet='Bonus Line' id='1' />
