  <dashboards>
    <dashboard name=' Residency' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Do Residents get better APR Offers?</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#0a1f44' />
        </style-rule>
        <style-rule element='story-description'>
          <format attr='background-color' value='#0a1f44d9' />
          <format attr='background-color' id='story-description_9' value='#e6e6e6d9' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='701' />
        </style-rule>
        <style-rule element='story-title'>
          <format attr='color' value='#f28e2b' />
          <format attr='background-color' value='#0a1f44' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' preset-index='1' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='7' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone h='5125' id='8' type-v2='title' w='98400' x='800' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='92875' id='1' param='vert' removable='false' type-v2='layout-flow' w='98400' x='800' y='6125'>
              <zone fixed-size='128' h='16000' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98400' x='800' y='6125' />
              <zone h='76875' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98400' x='800' y='22125'>
                <flipboard active-id='11' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Before we compare APR offers by residency status, it’s important to highlight a major limitation: only 8% of the data comes from non-resident mortgage simulations.&#10;This means that 92% of all loan observations are for Spanish residents, making our dataset heavily skewed. As a result, any conclusions about differences between residents and non-residents should be interpreted with caution — we cannot generalize based on such a small sample size.' captured-sheet='Residency Pie' id='12' />
                    <story-point caption='Residents receive 0.8% lower APRs on average compared to non-residents. A statistical test confirms this difference is significant (p = 0.02), suggesting residency status influences mortgage pricing.&#10;However, this finding is based on simulations from only two banks, so it cannot be generalized to the full market.' captured-sheet='APR Customer Type' id='11' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='8625' id='9' story-point-id='11' type-v2='text' w='18600' x='78300' y='79500'>
          <formatted-text>
            <run fontsize='10'>In scope: Fixed loans only.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{1F400239-B392-4B10-BD7F-B7FD94D379AF}' />
    </dashboard>
    <dashboard name='Bank Type' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Corbel' fontsize='20'>Do Traditional Banks offer better APRs?</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#0a1f44' />
