              <zone h='77625' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98400' x='800' y='21375'>
                <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='On average, digital banks provide an APR of 3.5%, compared to 4.4% from traditional institutions. A statistical test confirms this difference is highly significant (p = 0.00). This likely reflects more competitive pricing strategies, leaner operations, or efforts to appeal to tech-savvy, price-sensitive customers.' captured-sheet='APR Bank Type' id='1' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
