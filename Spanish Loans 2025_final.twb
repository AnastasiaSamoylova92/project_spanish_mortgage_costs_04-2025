            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{32B6C8DB-3A77-4F98-BFF9-3BD962F9CA62}' />
    </dashboard>
